# Copy to .env and fill in. Never commit .env.

# Claude scores each news item's impact on the stock. Without it, a crude keyword scorer is used.
ANTHROPIC_API_KEY=
# SCORING_MODEL=claude-opus-5-5
# SCORING_EFFORT=low

# Angel One SmartAPI (smartapi.angelbroking.com -> create an app to get the API key).
# TOTP secret = the base32 key shown when you enable TOTP for SmartAPI.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Telegram alerts (optional): create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage: SQLite by default. For Postgres:
# DATABASE_URL=postgresql+asyncpg://signalgraph:signalgraph@localhost:5432/signalgraph

# GREEN_THRESHOLD=0.25
# RED_THRESHOLD=-0.25
# ALERT_IMPACT=0.25
